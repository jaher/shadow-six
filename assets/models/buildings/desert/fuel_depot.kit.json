is":6082,"bytes":327736,"bytes_src":803016},{"file":"fuel_depot_lod2.glb","tris":3060,"bytes":169444,"bytes_src":524592}],"materials":["bitumen_felt","burlap_bag","cast_iron","concrete_formwork","concrete_slab","corrugated_rust","corrugated_zinc","decals_dz","sand","signs","steel_painted","timber_beam","timber_grey","wood_paint"],"theater":"desert","snow":false,"nodes":["main","decals"],"vertex_colors":"COLOR_0 ubyte (grime x base colour; alpha = decal opacity)","revision":"desert rework 2 (2026-09-26)","rework":{"asset":"roof and cladding are real corrugated sheets (0.15 m profile visible at the eaves, lapped, galvanised with rusty replacements, ridge flashing); gable framing + cladding; slab expansion joints, drain grating, soft oil stains; fuel hand-pump stand with crank and hose, funnels, sand bin + fire beaters, sand drifts","common":"new desert lib materials with real albedo breakup (limewash_worn, mud_render, mudbrick, sandstone_ochre, screed_roof, bitumen_felt, corrugated_galv, patio_flags, palm_log, canvas_camo, darj_panel); decal atlas feathered (no hard quads); interior_dark cards replaced by dim plaster / modelled interiors; AO atlas background dilated (no black mip bleed); warm sand-bounce vertex tint on sun-averted faces; KHR_mesh_quantization (normals/tangents int8, uv1 u16); effective-albedo floor (material lum >= 0.045 linear, material x vertex-colour >= 0.03) and opacity caps on near-black decals (soot 0.5, crack 0.7) so iron, tar, char, scorch and crude never render as pure-black voids; LOD2 re-tuned to ~12-15% of LOD0"},"rework2":{"asset":"galvanised corrugated iron (corrugated_zinc, texture corrugation matched to the 0.15 m geometry); weathered concrete slab + formwork kerb with oil/wet/wear decals; irregular sandbag blast walls.","common":"LOD1/LOD2 rebuilt with a shape-preserving per-part reducer (lodfix.py): planar dissolve per part delimited by material, UV seams and vertex-colour bands; only curved parts are collapse-decimated, each on its 